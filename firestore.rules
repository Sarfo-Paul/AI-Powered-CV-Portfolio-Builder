rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName']) &&
             data.uid == request.auth.uid &&
             data.fullName is string && data.fullName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'location', 'website', 'bio', 'photoURL']);

      // --- Resumes Subcollection ---
      match /resumes/{resumeId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidResume(incoming()) && 
                     incoming().userId == userId &&
                     incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidResume(incoming()) &&
                     incoming().userId == userId &&
                     incoming().updatedAt == request.time &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['title', 'templateId', 'summary', 'experiences', 'education', 'skills', 'projects', 'updatedAt']);
        allow delete: if isOwner(userId);
      }
    }

    function isValidResume(data) {
      return data.userId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.templateId is string &&
             data.summary is string && data.summary.size() <= 5000 &&
             data.experiences is list && data.experiences.size() <= 50 &&
             data.education is list && data.education.size() <= 50 &&
             data.skills is list && data.skills.size() <= 100 &&
             data.projects is list && data.projects.size() <= 50;
    }
  }
}
