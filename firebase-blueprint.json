{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information and professional settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "website": { "type": "string" },
        "bio": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName"]
    },
    "Resume": {
      "title": "Resume",
      "description": "A user's resume data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "templateId": { "type": "string" },
        "summary": { "type": "string" },
        "experiences": { "type": "array" },
        "education": { "type": "array" },
        "skills": { "type": "array" },
        "projects": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "User CV documents"
    }
  }
}
